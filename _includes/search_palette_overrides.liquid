{% assign current_lang = page.lang | default: site.lang | default: 'en' %}

{% if current_lang == 'ko' %}
  {% assign search_placeholder = '검색어를 입력하세요' %}
  {% assign search_section = '메뉴' %}
  {% assign footer_select = '선택' %}
  {% assign footer_navigate = '이동' %}
  {% assign footer_close = '닫기' %}
{% else %}
  {% assign search_placeholder = 'Type to start searching' %}
  {% assign search_section = 'Navigation' %}
  {% assign footer_select = 'select' %}
  {% assign footer_navigate = 'navigate' %}
  {% assign footer_close = 'close' %}
{% endif %}

{% if site.search_enabled %}
<style>
  ninja-keys [slot="footer"] {
    display: block;
    border-top: 1px solid var(--global-divider-color);
    background: var(--global-bg-color);
  }

  .jm-ninja-footer {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    padding: 0.55rem 0.9rem;
    font-size: 0.78rem;
    color: var(--global-text-color-light);
    line-height: 1.2;
  }

  .jm-ninja-help {
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
    white-space: nowrap;
  }

  .jm-ninja-footer kbd {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.35rem;
    height: 1.25rem;
    padding: 0 0.35rem;
    border: 1px solid var(--global-divider-color);
    border-radius: 0.25rem;
    background: var(--global-code-bg-color, #f3f4f6);
    color: var(--global-text-color);
    font-family: inherit;
    font-size: 0.68rem;
    font-weight: 500;
    line-height: 1;
    box-shadow: none;
  }

  @media (max-width: 576px) {
    .jm-ninja-footer {
      gap: 0.65rem;
      padding: 0.5rem 0.65rem;
      font-size: 0.72rem;
      flex-wrap: wrap;
    }

    .jm-ninja-footer kbd {
      min-width: 1.2rem;
      height: 1.15rem;
      font-size: 0.62rem;
      padding: 0 0.28rem;
    }
  }
</style>
<script>
  (function () {
    const jmSearchPlaceholder = {{ search_placeholder | jsonify }};
    const jmSearchSection = {{ search_section | jsonify }};
    const jmFooterSelect = {{ footer_select | jsonify }};
    const jmFooterNavigate = {{ footer_navigate | jsonify }};
    const jmFooterClose = {{ footer_close | jsonify }};

    const jmSearchData = [
      {% assign sorted_pages = site.pages | sort: "nav_order" %}
      {% for p in sorted_pages %}
        {% assign p_lang = p.lang | default: site.lang | default: 'en' %}
        {% if p.nav and p.autogen == null and p_lang == current_lang %}
          {% unless p.dropdown %}
            {% assign p_title = p.title | strip %}
            {% assign p_description = p.description | default: '' | strip_html | strip_newlines | strip %}

            {% if p.permalink contains '://' %}
              {% assign p_url = p.permalink %}
            {% else %}
              {% assign p_url = p.url | relative_url %}
            {% endif %}

            {
              id: {{ 'jm-' | append: current_lang | append: '-' | append: p.url | slugify | jsonify }},
              title: {{ p_title | jsonify }},
              description: {{ p_description | jsonify }},
              section: jmSearchSection,
              handler: () => {
                window.location.href = {{ p_url | jsonify }};
              },
            },
          {% endunless %}
        {% endif %}
      {% endfor %}
    ];

    function makeFooterHTML() {
      return `
        <div class="jm-ninja-footer">
          <span class="jm-ninja-help">
            <kbd>enter</kbd>
            <span>${jmFooterSelect}</span>
          </span>
          <span class="jm-ninja-help">
            <kbd>↑</kbd><kbd>↓</kbd>
            <span>${jmFooterNavigate}</span>
          </span>
          <span class="jm-ninja-help">
            <kbd>esc</kbd>
            <span>${jmFooterClose}</span>
          </span>
        </div>
      `;
    }

    function patchNinjaKeys() {
      const ninja = document.querySelector("ninja-keys");

      if (!ninja) {
        return false;
      }

      // Replace al-search's default data with language-specific navigation only.
      ninja.data = jmSearchData;

      // Localize placeholder.
      ninja.placeholder = jmSearchPlaceholder;
      ninja.setAttribute("placeholder", jmSearchPlaceholder);

      // Remove duplicate/default footer text and replace with localized footer.
      let footer = ninja.querySelector("[slot='footer']");

      if (!footer) {
        footer = document.createElement("div");
        footer.setAttribute("slot", "footer");
        ninja.appendChild(footer);
      }

      footer.innerHTML = makeFooterHTML();

      return true;
    }

    function patchWithRetries() {
      [0, 50, 150, 400, 1000, 2000].forEach(function (delay) {
        window.setTimeout(patchNinjaKeys, delay);
      });
    }

    document.addEventListener("DOMContentLoaded", patchWithRetries);
    window.addEventListener("load", patchWithRetries);

    if (window.customElements && customElements.whenDefined) {
      customElements.whenDefined("ninja-keys").then(patchWithRetries);
    }
  })();
</script>
{% endif %}
