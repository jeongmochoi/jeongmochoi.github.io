<script>
  document.addEventListener("DOMContentLoaded", function () {
    const getTargetSelector = function (link) {
      if (link.classList.contains("abstract-ko")) {
        return ".abstract-ko.hidden";
      }

      if (link.classList.contains("abstract")) {
        return ".abstract.hidden";
      }

      return null;
    };

    document.addEventListener(
      "click",
      function (event) {
        const link = event.target.closest("a.abstract, a.abstract-ko");

        if (!link) {
          return;
        }

        const targetSelector = getTargetSelector(link);

        if (!targetSelector) {
          return;
        }

        event.preventDefault();

        // Prevent the default al-folio abstract toggle from also firing.
        event.stopPropagation();
        event.stopImmediatePropagation();

        const entry = link.closest("li");

        if (!entry) {
          return;
        }

        const targetPanel = entry.querySelector(targetSelector);

        if (!targetPanel) {
          return;
        }

        const wasOpen = targetPanel.classList.contains("open");

        // Close all expandable panels in the same publication entry.
        entry
          .querySelectorAll(
            ".abstract.hidden.open, .abstract-ko.hidden.open, .award.hidden.open, .bibtex.hidden.open"
          )
          .forEach(function (panel) {
            panel.classList.remove("open");
          });

        // If the clicked panel was closed, open it.
        // If it was already open, leave everything closed.
        if (!wasOpen) {
          targetPanel.classList.add("open");
        }
      },
      true
    );
  });
</script>
