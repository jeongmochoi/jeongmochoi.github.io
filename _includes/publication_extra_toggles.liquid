<script>
  document.addEventListener("DOMContentLoaded", function () {
    const resolveToggleScope = function (link) {
      const linksContainer = link.closest(".links");

      if (linksContainer && linksContainer.parentElement) {
        return linksContainer.parentElement;
      }

      return link.closest("li, .row") || link.parentElement;
    };

    document.querySelectorAll("a.abstract-ko").forEach(function (link) {
      link.addEventListener("click", function (event) {
        event.preventDefault();

        const scope = resolveToggleScope(link);

        if (!scope) {
          return;
        }

        const panel = scope.querySelector(".abstract-ko.hidden");

        if (!panel) {
          return;
        }

        scope
          .querySelectorAll(".abstract.hidden.open, .abstract-ko.hidden.open, .award.hidden.open, .bibtex.hidden.open")
          .forEach(function (openPanel) {
            if (openPanel !== panel) {
              openPanel.classList.remove("open");
            }
          });

        panel.classList.toggle("open");
      });
    });
  });
</script>
