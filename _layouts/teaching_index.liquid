---
layout: page
---

{% assign current_lang = page.lang | default: 'en' %}
{% assign courses = site.data.courses | sort: 'order' %}

<div class="teaching-index">

  {{ content }}

  <div class="course-list">
    {% for course in courses %}
      <section class="course-entry" id="{{ course.id }}">
        <div class="course-line">
          <div class="course-name">
            <span class="course-title-ko">{{ course.title_ko }}</span>
            <span class="course-title-separator">/</span>
            <span class="course-title-en">{{ course.title_en }}</span>
          </div>

          <div class="course-terms">
            {% for offering in course.offerings %}
              {% assign offering_url = offering.url %}

              {% if current_lang == 'ko' and offering.url_ko %}
                {% assign offering_url = offering.url_ko %}
              {% elsif current_lang != 'ko' and offering.url_en %}
                {% assign offering_url = offering.url_en %}
              {% endif %}

              {% assign term_year = offering.term | slice: 0, 4 %}
              {% assign term_year_short = term_year | slice: 2, 2 %}
              {% assign term_semester = offering.term | slice: 4, 1 %}

              {% if offering.label %}
                {% assign term_label = offering.label %}
              {% else %}
                {% assign term_label = term_year_short | append: term_semester %}
              {% endif %}

              {% if term_semester == 'S' %}
                {% assign term_en = 'Spring ' | append: term_year %}
                {% assign term_ko = term_year | append: ' 봄학기' %}
              {% elsif term_semester == 'F' %}
                {% assign term_en = 'Fall ' | append: term_year %}
                {% assign term_ko = term_year | append: ' 가을학기' %}
              {% else %}
                {% assign term_en = offering.term %}
                {% assign term_ko = offering.term %}
              {% endif %}

              {% capture offering_title -%}
                {%- if current_lang == 'ko' -%}
                  {{ term_ko -}}
                  {%- if offering.unit_ko -%}
                    , {{ offering.unit_ko -}}
                  {%- endif -%}
                {%- else -%}
                  {{ term_en -}}
                  {%- if offering.unit_en -%}
                    , {{ offering.unit_en -}}
                  {%- endif -%}
                {%- endif -%}
              {%- endcapture %}

              {% capture term_display -%}
                {{- term_label -}}
                {%- if offering.suffix -%}
                  <sub>{{- offering.suffix -}}</sub>
                {%- endif -%}
              {%- endcapture %}

              {% assign page_exists = false %}

              {% if offering_url %}
                {% for site_page in site.pages %}
                  {% if site_page.url == offering_url %}
                    {% assign page_exists = true %}
                  {% endif %}
                {% endfor %}

                {% for teaching_page in site.teachings %}
                  {% if teaching_page.url == offering_url %}
                    {% assign page_exists = true %}
                  {% endif %}
                {% endfor %}
              {% endif %}

              {% if offering_url and page_exists %}
                <a
                  class="course-term-link"
                  href="{{ offering_url | relative_url }}"
                  title="{{ offering_title | strip }}"
                  aria-label="{{ offering_title | strip }}"
                >{{ term_display }}</a>
              {% else %}
                <span
                  class="course-term-link disabled"
                  title="{{ offering_title | strip }}"
                  aria-label="{{ offering_title | strip }}"
                >{{ term_display }}</span>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      </section>
    {% endfor %}
  </div>

</div>
