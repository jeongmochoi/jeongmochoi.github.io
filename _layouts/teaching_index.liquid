---
layout: page
---

{% assign current_lang = page.lang | default: 'en' %}
{% assign courses = site.data.courses | sort: 'order' %}

<div class="teaching-index">

  {{ content }}

  <div class="course-list">
    {% for course in courses %}
      {% if current_lang == 'ko' %}
        {% assign title_main = course.title_ko | default: course.title_en %}
        {% assign title_sub = course.title_en | default: course.title_ko %}
      {% else %}
        {% assign title_main = course.title_en | default: course.title_ko %}
        {% assign title_sub = course.title_ko | default: course.title_en %}
      {% endif %}

      <section class="course-entry" id="{{ course.id }}">
        <div class="course-heading">
          <h3 class="course-title">{{ title_main }}</h3>

          {% if title_sub and title_sub != title_main %}
            <div class="course-subtitle">{{ title_sub }}</div>
          {% endif %}
        </div>

        {% if course.offerings %}
          <div class="course-term-list">
            {% for offering in course.offerings %}
              {% assign offering_url = offering.url_ko %}

              {% if current_lang != 'ko' and offering.url_en %}
                {% assign offering_url = offering.url_en %}
              {% endif %}

              {% capture offering_title %}
                {{ offering.term }}
                {% if offering.section %}, section {{ offering.section }}{% endif %}
                {% if offering.unit_short %}, {{ offering.unit_short }}{% endif %}
              {% endcapture %}

              {% if offering_url %}
                <a
                  class="course-term-chip"
                  href="{{ offering_url | relative_url }}"
                  title="{{ offering_title | strip }}"
                >
                  {{ offering.label }}
                </a>
              {% else %}
                <span class="course-term-chip disabled" title="{{ offering_title | strip }}">
                  {{ offering.label }}
                </span>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
      </section>
    {% endfor %}
  </div>

</div>
